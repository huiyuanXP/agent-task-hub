      "checkConstraints": {
        "execution_runs_ticket_revision": {
          "name": "execution_runs_ticket_revision",
          "value": "\"execution_runs\".\"ticket_revision\" > 0"
        },
        "execution_runs_ticket_body": {
          "name": "execution_runs_ticket_body",
          "value": "length(\"execution_runs\".\"ticket_body\") <= 80000 AND json_valid(\"execution_runs\".\"ticket_body\") AND json_type(\"execution_runs\".\"ticket_body\") = 'object'"
        },
        "execution_runs_request_id": {
          "name": "execution_runs_request_id",
          "value": "length(\"execution_runs\".\"request_id\") BETWEEN 1 AND 128"
        },
        "execution_runs_attempt": {
          "name": "execution_runs_attempt",
          "value": "\"execution_runs\".\"attempt\" > 0"
        },
        "execution_runs_source": {
          "name": "execution_runs_source",
          "value": "\"execution_runs\".\"source\" = 'execution'"
        },
        "execution_runs_state": {
          "name": "execution_runs_state",
          "value": "\"execution_runs\".\"state\" IN ('queued','running','waiting','succeeded','failed','cancelled')"
        },
        "execution_runs_version": {
          "name": "execution_runs_version",
          "value": "\"execution_runs\".\"version\" > 0"
        },
        "execution_runs_evidence": {
          "name": "execution_runs_evidence",
          "value": "\"execution_runs\".\"evidence\" IS NULL OR (length(\"execution_runs\".\"evidence\") <= 16000 AND json_valid(\"execution_runs\".\"evidence\"))"
        },
        "execution_runs_success": {
          "name": "execution_runs_success",
          "value": "(\"execution_runs\".\"state\" = 'succeeded' AND \"execution_runs\".\"evidence\" IS NOT NULL) OR (\"execution_runs\".\"state\" <> 'succeeded' AND \"execution_runs\".\"evidence\" IS NULL)"
        }
      }
    },
