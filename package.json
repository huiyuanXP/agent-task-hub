{
  "name": "agent-task-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node --experimental-strip-types scripts/server.mjs --dev",
    "build": "node scripts/build.mjs",
    "start": "node --experimental-strip-types scripts/server.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test": "npm run test:unit && npm run test:execution && npm run test:browser-policy && npm run test:auth && npm run test:auth:api && npm run test:mcp:task-reads && npm run test:planning:revisions && npm run test:planning:recovery && npm run test:planning:lifecycle && npm run test:planning:browser && npm run test:auth:browser && npm run test:integration",
    "test:browser-policy": "node --test tests/browser/*.test.mjs",
    "test:execution": "node --experimental-strip-types --test --test-concurrency=1 tests/execution/*.test.mjs",
    "test:execution:api": "node --experimental-strip-types tests/execution/worker-api.mjs",
    "test:workspaces": "node --experimental-strip-types --test --test-concurrency=1 tests/execution/workspaces.test.mjs tests/execution/docker.test.mjs tests/execution/artifacts.test.mjs tests/execution/inputs.test.mjs tests/execution/watchdog.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth/*.test.mjs",
    "test:auth:api": "npm run build && node --experimental-strip-types tests/auth/worker-api.mjs",
    "test:auth:browser": "node --experimental-strip-types tests/auth/browser.mjs",
    "test:planning:revisions": "node --experimental-strip-types tests/planning/revisions.mjs",
    "test:execution:configuration": "node --experimental-strip-types tests/execution/mcp-configuration-worker.mjs",
    "test:backend:integration": "node --experimental-strip-types tests/execution/backend-worker.mjs",
    "test:planning:recovery": "node --experimental-strip-types tests/planning/recovery.mjs",
    "test:planning:lifecycle": "node --experimental-strip-types tests/planning/lifecycle.mjs",
    "test:planning:browser": "node --experimental-strip-types tests/planning/browser.mjs",
    "test:mcp:task-reads": "node --experimental-strip-types tests/mcp/task-reads.mjs && npm run test:mcp:task-runs",
    "test:mcp:task-runs": "node --experimental-strip-types tests/mcp/task-run-reads.mjs",
    "accounts": "node --experimental-strip-types scripts/accounts.mjs",
    "test:local": "node --experimental-strip-types --test tests/local/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
